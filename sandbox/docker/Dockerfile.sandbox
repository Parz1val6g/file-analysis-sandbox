# Sandbox Extractor Image — multi-stage C build
# Stage 1: compile the C extractor
FROM alpine:3.19 AS builder
RUN apk add --no-cache build-base
COPY extractor.c /tmp/extractor.c
RUN gcc -O2 -s -Wall -Werror -o /extractor /tmp/extractor.c

# Stage 2: minimal runtime image
FROM alpine:3.19
RUN apk add --no-cache \
    file \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-data-eng
COPY --from=builder /extractor /opt/extractor
RUN chmod +x /opt/extractor

ENTRYPOINT ["/opt/extractor"]
